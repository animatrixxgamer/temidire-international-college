# Temidire International College — environment template
# Copy to .env for local development (never commit .env)

# SQLite for local dev. On Vercel, switch DATABASE_URL to your free Neon Postgres URL.
DATABASE_URL="file:./dev.db"

# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-long-random-string"

# Super admin created by `npm run db:seed`
SUPER_ADMIN_EMAIL="admin@temidirecollege.ng"
SUPER_ADMIN_PASSWORD="ChangeMe-2026!"

# Optional: Vercel/Neon production URL (paste from Neon dashboard)
# POSTGRES_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
